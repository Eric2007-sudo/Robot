<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>locator_launcher</name>
  <version>0.0.0</version>
  <description>Launch, rviz config and accuracy verification for the locator project</description>
  <maintainer email="cicada@example.com">cicada</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>locator</exec_depend>
  <exec_depend>locator_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
